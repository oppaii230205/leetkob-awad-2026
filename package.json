{
  "name": "leetkob-pa2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeeTKOB PA2: an enforced quality gate and transactional lab publishing contract",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo:seed": "node scripts/seed-demo.ts",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
